<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:ads="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/clip_very_green">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:context=".CatchEntryTournament"
        android:paddingTop="5dp">

        <!-- Flavor Label -->
        <ImageView
            android:id="@+id/imgWordmark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:maxHeight="56dp"
            android:adjustViewBounds="true"
            android:contentDescription="@string/app_name"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/timeNOW"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/wordmark" />

        <TextClock
            android:id="@+id/timeNOW"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="28dp"
            android:layout_marginTop="5dp"
            android:layout_marginEnd="1dp"
            android:layout_marginBottom="19dp"
            android:gravity="center"
            android:padding="5dp"
            android:textAllCaps="true"
            android:textColor="@color/black"
            android:textSize="34sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/imgWordmark"
            app:layout_constraintEnd_toStartOf="@+id/imgWordmark"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="@string/timer_place_holder" />

        <Button
            android:id="@+id/btnStartFishingPounds"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginVertical="5dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/btn_add_catch"
            android:gravity="center"
            android:shadowColor="#8FC16D"
            android:text="@string/addCatchBtn"
            android:textColor="@color/clip_white"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintHeight_percent="0.09"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="@id/firstRealWeightPounds"
            app:layout_constraintEnd_toEndOf="@id/firstDecWeightPounds"
            app:layout_constraintTop_toBottomOf="@+id/imgWordmark" />



