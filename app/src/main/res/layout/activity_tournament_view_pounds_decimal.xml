            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/totalRealWeightPounds"
            app:layout_constraintEnd_toStartOf="@+id/txtHolderOzs"
            app:layout_constraintHeight_percent="0.1"
            app:layout_constraintStart_toEndOf="@id/txtLbHolder"
            app:layout_constraintTop_toBottomOf="@+id/total_weightView"
